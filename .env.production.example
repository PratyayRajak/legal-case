# Production Environment Configuration
# Court Brief Engine - Bilingual Judicial System

# Environment
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Application Security
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_KEY
ALLOWED_HOSTS=court-engine.internal,api.courteval.gov.in
CORS_ORIGINS=https://court-engine.internal,https://courteval.gov.in

# Indian PII Fernet Encryption Key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=CHANGE_THIS_PRODUCTION_FERNET_KEY_FOR_REVERSIBLE_PII_STORAGE

# LLM Providers & Grounding
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_production_gemini_api_key_here
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Database (PostgreSQL 16 with pgvector)
# AWS RDS Multi-AZ Mumbai (ap-south-1)
DATABASE_URL=postgresql://court_app_user:secure_password_here@court-db-primary.internal:5432/courtdb_prod

# Redis (Caching & Celery Broker)
REDIS_URL=redis://:redis_auth_token@court-redis.internal:6379/0

# Object Storage (S3 / MinIO - AWS Mumbai ap-south-1)
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_BUCKET_NAME=indian-court-brief-documents-prod
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_REGION=ap-south-1

# Performance & Rate Limits
MAX_PDF_SIZE_MB=50
OCR_MAX_PAGES=50
RATE_LIMIT_REQUESTS_PER_MINUTE=60
